    {
      "name": "firms_build_kml_footprint_url",
      "version": "1.0.0",
      "title": "Build a KML fire footprint link",
      "description": "Build FIRMS's keyless download link for a KML file of recent fire points and pixel footprints for a region (near real-time data, last 24 hours to 7 days). The file opens in a GIS tool such as Google Earth or QGIS, not in a browser.\n\nOffer it only when the user mentions GIS, footprints, Google Earth, or QGIS; otherwise ask whether they work with KML files before suggesting it. Say that the link downloads a file. Landsat footprints exist only for canada and usa_contiguous_and_hawaii.",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "region": {
            "type": "string",
            "enum": [
              "canada",
              "alaska",
              "usa_contiguous_and_hawaii",
              "central_america",
              "south_america",
              "europe",
              "northern_and_central_africa",
              "southern_africa",
              "russia_asia",
              "south_asia",
              "southeast_asia",
              "australia_newzealand"
            ],
            "description": "FIRMS KML region"
          },
          "period": {
            "type": "string",
            "enum": [
              "24h",
              "48h",
              "72h",
              "7d"
            ],
            "description": "How far back: 24h, 48h, 72h, or 7d"
          },
          "sensor": {
            "type": "string",
            "enum": [
              "viirs_noaa20",
              "viirs_noaa21",
              "viirs_snpp",
              "modis",
              "landsat"
            ],
            "description": "Sensor whose footprints to download"
          }
        },
        "required": [
          "region",
          "period",
          "sensor"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "region_label": {
            "type": "string"
          },
          "period": {
            "type": "string"
          },
          "period_label": {
            "type": "string"
          },
          "sensor": {
            "type": "string"
          },
          "sensor_label": {
            "type": "string"
          },
          "downloads_file": {
            "type": "boolean",
            "const": true
          },
          "note": {
            "type": "string"
          },
          "limitations": {
            "type": "string"
          }
        },
        "required": [
          "url",
          "region",
          "region_label",
          "period",
          "period_label",
          "sensor",
          "sensor_label",
          "downloads_file",
          "note",
          "limitations"
        ],
        "additionalProperties": false
      }
    },
