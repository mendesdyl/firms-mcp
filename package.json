{
  "name": "firms-mcp-server",
  "version": "0.3.0",
  "private": true,
  "description": "Keyless MCP server for NASA FIRMS: verbatim FIRMS documentation, Fire Map and FIRMS API URL building, standard data first",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "firms-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "contracts",
    "knowledge"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "smoke": "tsx scripts/ts/smoke.ts",
    "contracts": "tsx scripts/ts/contracts.ts",
    "contracts:check": "tsx scripts/ts/contracts.ts --check",
    "traceability": "tsx scripts/ts/traceability.ts",
    "traceability:check": "tsx scripts/ts/traceability.ts --check",
    "map-catalog": "tsx scripts/ts/map-catalog.ts",
    "check": "npm run lint && npm run typecheck && npm run knowledge -- validate && npm test && npm run contracts:check && npm run traceability:check && npm run build && npm run smoke",
    "knowledge": "tsx scripts/ts/knowledge.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "express": "5.3.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "css-select": "7.0.0",
    "domhandler": "6.0.1",
    "domutils": "4.0.2",
    "htmlparser2": "12.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
