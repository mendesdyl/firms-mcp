# FIRMS MCP configuration. Copy to .env (git-ignored) and adjust; every setting is optional.
# Full reference: docs/developers/CONFIGURATION.md
#
# The server is keyless: it never needs or accepts a FIRMS MAP_KEY. URLs it builds contain the
# placeholder [MAP_KEY] for the user to fill in.

# --- HTTP transport (`firms-mcp-server http`) ----------------------------------------------
# Bind address and port. Binding anywhere but 127.0.0.1/localhost requires
# FIRMS_MCP_ALLOWED_HOSTS, or the server refuses to start (DNS-rebinding protection).
FIRMS_MCP_HOST=127.0.0.1
FIRMS_MCP_PORT=8000
# Host names accepted in the Host header, comma-separated, e.g. firms-mcp.example.org
FIRMS_MCP_ALLOWED_HOSTS=

# --- Knowledge base ------------------------------------------------------------------------
# Extra knowledge directories (':'-separated), validated like the built-in content.
FIRMS_MCP_KNOWLEDGE_DIRS=
