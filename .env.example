# FIRMS MCP configuration. Copy to .env (git-ignored) and adjust.
# Full reference: docs/developers/CONFIGURATION.md

# --- Local (stdio) use -------------------------------------------------------------------
# Your FIRMS MAP_KEY (free: https://firms.modaps.eosdis.nasa.gov/api/map_key/).
# Never commit it and never paste it into a chat.
FIRMS_MAP_KEY=

# --- FIRMS access ------------------------------------------------------------------------
FIRMS_API_BASE_URL=https://firms.modaps.eosdis.nasa.gov
FIRMS_MCP_HTTP_TIMEOUT=60
FIRMS_MCP_HTTP_RETRIES=2
FIRMS_MCP_RETRY_BACKOFF=0.5

# --- Upstream discipline -----------------------------------------------------------------
# Response cache TTLs (seconds) for near-real-time and standard-processing sources.
FIRMS_MCP_CACHE_TTL_NRT=300
FIRMS_MCP_CACHE_TTL_SP=21600
FIRMS_MCP_CACHE_MAX_ENTRIES=256
# Client-side ceiling on estimated transactions per key per 10 minutes (FIRMS allows 5000).
FIRMS_MCP_TRANSACTION_BUDGET=4500

# --- Links ---------------------------------------------------------------------------------
# Add utm_source=firms-mcp&utm_medium=mcp to FIRMS Fire Map links.
FIRMS_MCP_REFERRAL=true

# --- Knowledge base ----------------------------------------------------------------------
# Extra knowledge directories (':'-separated), validated like the built-in content.
FIRMS_MCP_KNOWLEDGE_DIRS=

# --- Server --------------------------------------------------------------------------------
# Bind address and port for `firms-mcp http`; log level (JSON logs on stderr).
FIRMS_MCP_HOST=127.0.0.1
FIRMS_MCP_PORT=8000
FIRMS_MCP_LOG_LEVEL=INFO

# --- Remote deployments (see docs/design/AUTHENTICATION.md) ------------------------------
# Serve anonymous data requests with an operator-wide key (FIRMS_MAP_KEY). Off by default.
FIRMS_MCP_ALLOW_OPERATOR_KEY=false
# MAP_KEY connect flow for `firms-mcp http`: oauth (default) or none.
FIRMS_MCP_AUTH=oauth
# Public base URL clients use (OAuth issuer and resource), e.g. https://firms-mcp.example.org
FIRMS_MCP_PUBLIC_URL=
# Token encryption keys: run `firms-mcp keygen`; first entry encrypts, all decrypt.
FIRMS_MCP_TOKEN_KEYS=
FIRMS_MCP_ACCESS_TOKEN_TTL=3600
FIRMS_MCP_REFRESH_TOKEN_TTL=2592000
FIRMS_MCP_ENABLE_CIMD=true
FIRMS_MCP_ENABLE_DCR=true
